{
  "framework": null,
  "functions": {
    "api/upload.py": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "pdfllm/**",
      "excludeFiles": "{dist/**,raw/**,polyglot/**,viz/**,assets/**,index.html,*.md,build.sh,update_index.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/upload.py"
    }
  ]
}
