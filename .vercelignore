# Build artifacts — not needed at runtime on Vercel.
# dist/ IS needed: dist/resume.pdf is served statically (pdf.js fetches
# /dist/resume.pdf) and is bundled into the function via vercel.json's
# includeFiles. Do not exclude it.
engine/
model/
polyglot/__pycache__/
api/__pycache__/
*.bin
*.so
build.sh
update_index.py
examples/
viz/
assets/
raw/
